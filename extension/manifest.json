{
  "manifest_version": 3,
  "name": "InThePage",
  "short_name": "InThePage",
  "version": "1.1.0",
  "description": "שיחה חיה, תגובות ומדיה על כל דף שאתם קוראים, עם מי שקורא אותו עכשיו. בפאנל צד, במסך מפוצל או בדף מלא.",
  "default_locale": "he",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "shell.html"
  },
  "action": {
    "default_title": "InThePage — מי עוד נמצא בדף הזה",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-split": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "מסך מפוצל: הדף למעלה, InThePage למטה"
    }
  },
  "homepage_url": "https://inthepage.com/"
}
