{
  "manifest_version": 3,
  "name": "AddMedia",
  "short_name": "AddMedia",
  "version": "0.1.0",
  "description": "שיחה חיה, תגובות ומדיה על כל דף שאתם קוראים — עם כל מי שקורא אותו עכשיו.",
  "default_locale": "he",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel/index.html" },
  "action": {
    "default_title": "AddMedia — מי עוד קורא את הדף הזה",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "commands": {
    "toggle-split": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "מסך מפוצל: הדף למעלה, AddMedia למטה" }
  }
}
