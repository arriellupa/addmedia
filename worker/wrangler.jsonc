{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "addmedia",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "addmedia.noaplate.com", "custom_domain": true },
    { "pattern": "addstudent.noaplate.com", "custom_domain": true },
    { "pattern": "addstudent.com", "custom_domain": true },
    { "pattern": "www.addstudent.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PageRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PageRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "addmedia",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "addmedia-media" }],
  "vars": {
    "APP_ORIGIN": "https://addmedia.noaplate.com",
    "FROM_EMAIL": "AddMedia <no-reply@noaplate.com>",
    "TEST_PURCHASES": "true",
    "DEV_MODE": "false"
  },
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
